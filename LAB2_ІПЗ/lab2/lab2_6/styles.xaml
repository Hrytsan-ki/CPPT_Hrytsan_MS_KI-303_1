<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Старовинний стиль для кнопок -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#D4B483" /> <!-- Теплий приглушений тон -->
        <Setter Property="Foreground" Value="#4A3627" /> <!-- Тьмяний темно-коричневий -->
        <Setter Property="FontFamily" Value="Times New Roman" /> <!-- Класичний шрифт -->
        <Setter Property="FontSize" Value="16" /> <!-- Більший розмір тексту для більш старовинного вигляду -->
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="BorderBrush" Value="#8B4513" /> <!-- Темна коричнева рамка -->
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="2" Color="#555" Opacity="0.6" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8"> <!-- Більш округлі краї -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C49B6A" /> <!-- Зміна кольору при наведенні -->
                <Setter Property="BorderBrush" Value="#704214" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#8B4513" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Старовинний стиль для текстових полів -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#F5F5DC" /> <!-- Легка текстура, схожа на пергамент -->
        <Setter Property="Foreground" Value="#4A3627" />
        <Setter Property="FontFamily" Value="Georgia" /> <!-- Шрифт з класичними засічками -->
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="#8B4513" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6"> <!-- Більш округлі краї -->
                        <ScrollViewer 
                            x:Name="PART_ContentHost" 
                            HorizontalScrollBarVisibility="Hidden" 
                            VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#704214" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#8B4513" />
                <Setter Property="Background" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#E0E0E0" />
                <Setter Property="Foreground" Value="#A9A9A9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Старовинний стиль для DatePicker -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="#F5F5DC" />
        <Setter Property="Foreground" Value="#4A3627" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="#8B4513" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6">
                        <Grid>
                            <DatePickerTextBox 
                                x:Name="PART_TextBox" 
                                Background="Transparent" 
                                Foreground="{TemplateBinding Foreground}" 
                                BorderThickness="0"
                                Padding="0,2" 
                                VerticalContentAlignment="Center"
                                Focusable="True" />
                            <Button 
                                x:Name="PART_Button" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                Margin="2,0" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <Path 
                                    Data="M0,0 L0,1 L1,1 L1,0 Z M0.25,0.25 L0.25,0.75 L0.75,0.75 L0.75,0.25 Z" 
                                    Fill="#4A3627" 
                                    Width="14" 
                                    Height="14" 
                                    Stretch="Uniform" />
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                                <Border Background="White" BorderBrush="#8B4513" BorderThickness="1.5" CornerRadius="6">
                                    <Calendar x:Name="PART_Calendar" Background="White" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#704214" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="#8B4513" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#E0E0E0" />
                <Setter Property="Foreground" Value="#A9A9A9" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Label" x:Key="HoverableLabelStyle">
        <Setter Property="Foreground" Value="#4A3627" /> <!-- Основний колір -->
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" /> <!-- Змінюємо курсор на руку -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#B22222" /> <!-- Колір при наведенні (червоний) -->
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
