<Window
    Height="450"
    MaxWidth="1000"
    MinHeight="200"
    MinWidth="1000"
    Title="Рейтинг поїздів"
    Width="1000"
    mc:Ignorable="d"
    x:Class="lab2_6.Pages.TrainRating"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_6.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>
    <Grid>

        <ListView
            Margin="10,60,10,20"
            VerticalAlignment="Stretch"
            x:Name="TripsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        DisplayMemberBinding="{Binding TripName}"
                        Header="Назва поїзда"
                        Width="210" />
                    <GridViewColumn
                        DisplayMemberBinding="{Binding StartDate}"
                        Header="Час поїздки"
                        Width="175" />
                    <GridViewColumn
                        DisplayMemberBinding="{Binding Mark}"
                        Header="Оцінка"
                        Width="100" />
                    <GridViewColumn
                        DisplayMemberBinding="{Binding TrainName}"
                        Header="Потяг"
                        Width="150" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button
            Click="CloseClick"
            Content="Назад"
            Height="30"
            HorizontalAlignment="Left"
            Margin="10"
            VerticalAlignment="Top"
            Width="250" />
        <Button
            Click="SortByRatingClick"
            Content="Сортувати за оцінкою"
            Height="30"
            HorizontalAlignment="Right"
            Margin="10"
            VerticalAlignment="Top"
            Width="250" />
    </Grid>
</Window>