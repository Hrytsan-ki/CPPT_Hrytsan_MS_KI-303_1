<Window
    Height="650"
    MaxHeight="650"
    MaxWidth="850"
    MinHeight="650"
    MinWidth="850"
    Title="Пошук поїздів"
    Width="850"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_6.Pages.SearchTrainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_6.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Margin="0,20,0,0"
            VerticalAlignment="Center"
            Width="750">

            <Label
                Content="Пошук поїздів"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,20" />

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <Label
                    Content="Назва рейсу:"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center" />
                <TextBox
                    Height="40"
                    Name="SearchTextBox"
                    TextChanged="SearchByName"
                    VerticalContentAlignment="Center"
                    Width="300" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <Label
                    Content="Дата рейсу:"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center" />
                <DatePicker
                    Height="40"
                    Name="SearchDatePicker"
                    SelectedDateChanged="SearchByData"
                    VerticalContentAlignment="Center"
                    Width="300" />
            </StackPanel>

            <ListView
                Height="250"
                Name="TripsListBox"
                SelectionChanged="TripsListBox_SelectionChanged"
                Width="750">
                <ListView.View>
                    <GridView>
                        <GridViewColumn
                            DisplayMemberBinding="{Binding TripName}"
                            Header="Назва рейсу"
                            Width="275" />
                        <GridViewColumn
                            DisplayMemberBinding="{Binding StartDate}"
                            Header="Час"
                            Width="165" />
                        <GridViewColumn Header="Кількість місць" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AmountSeats}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn
                            DisplayMemberBinding="{Binding TrainName}"
                            Header="Назва поїзда"
                            Width="100" />
                        <GridViewColumn
                            DisplayMemberBinding="{Binding Number}"
                            Header="Номер поїзда"
                            Width="85" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Button
                Click="RatingClick"
                Content="Рейтинг"
                Height="35"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Width="160" />
            <Button
                Click="CloseClick"
                Content="Вийти"
                Height="35"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Width="160" />
        </StackPanel>
    </Grid>
</Window>
