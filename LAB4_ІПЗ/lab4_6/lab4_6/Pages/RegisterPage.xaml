<Window x:Class="lab2_6.Pages.RegisterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:lab2_6.Pages"
        mc:Ignorable="d"
        Title="Купівля квитків" Height="550" Width="800" MinHeight="550" MinWidth="800" MaxHeight="550" MaxWidth="800" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#37474F" Padding="20">
            <TextBlock Text="Реєстрація в системі" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        
        <Grid Grid.Row="1" Grid.Column="0" Background="#ECEFF1">
            <TextBlock Text="Ласкаво просимо" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Реєстрація" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="Логін" FontSize="16"/>
                <TextBox Text="{Binding Login}" Height="40" Width="350" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="Пароль" FontSize="16"/>
                <TextBox Text="{Binding Password}" Height="40" Width="350" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="0,0,0,30">
                <TextBlock Text="Підтвердження паролю" FontSize="16"/>
                <TextBox Text="{Binding ConfirmationPassword}" Height="40" Width="350" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
            
            <Button Click="RegisterClick" Content="Зареєструватися" Width="160" Height="40" HorizontalAlignment="Center"/>
            
            <Label Content="Вже маєте акаунт? Залогінтесь" HorizontalAlignment="Center" Margin="0,0,0,20" VerticalAlignment="Top" MouseLeftButtonDown="GoToSignIn" Style="{StaticResource HoverableLabelStyle}"/>
        </StackPanel>
    </Grid>
</Window>
