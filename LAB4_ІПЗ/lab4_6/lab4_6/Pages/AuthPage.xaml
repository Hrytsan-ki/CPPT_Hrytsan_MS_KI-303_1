<Window
    Height="500"
    MinHeight="500"
    MinWidth="850"
    Title="Система квитків"
    Width="850"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_6.Pages.AuthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_6"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border
            Background="#37474F"
            Grid.ColumnSpan="2"
            Grid.Row="0"
            Padding="20">
            <TextBlock
                FontSize="28"
                Foreground="White"
                HorizontalAlignment="Center"
                Text="Вхід до системи" />
        </Border>

        <Grid
            Background="#ECEFF1"
            Grid.Column="0"
            Grid.Row="1">
            <TextBlock
                FontSize="24"
                HorizontalAlignment="Center"
                Text="Ласкаво просимо"
                VerticalAlignment="Center" />
        </Grid>

        <StackPanel
            Grid.Column="1"
            Grid.Row="1"
            Margin="20"
            VerticalAlignment="Center">
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Text="Авторизація" />

            <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                <TextBlock FontSize="16" Text="Логін" />
                <TextBox
                    Height="40"
                    Margin="0,5,0,0"
                    Text="{Binding Login}"
                    VerticalContentAlignment="Center"
                    Width="350" />
            </StackPanel>

            <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                <TextBlock FontSize="16" Text="Пароль" />
                <TextBox
                    Height="40"
                    Margin="0,5,0,0"
                    Text="{Binding Password}"
                    VerticalContentAlignment="Center"
                    Width="350" />
            </StackPanel>

            <Button
                Click="AuthClick"
                Content="Увійти"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,20,0,10"
                Width="160" />

            <Label
                Content="Не маєте акаунту? Зареєструйтеся"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                MouseLeftButtonDown="GoToSignUp"
                Style="{StaticResource HoverableLabelStyle}"
                VerticalAlignment="Top" />
        </StackPanel>
    </Grid>
</Window>
